#!/usr/bin/env python3
"""Delete every enrolled fingerprint for the current user.

No per-finger delete exists in this D-Bus API -- confirmed by reading
openfprintd's source (DeleteEnrolledFingers2 calls the same underlying
per-user DeleteEnrolledFingers as the legacy method) and python-validity's
backend (DeleteEnrolledFingers(user) drops the whole user record). This
script is deliberately all-or-nothing; the panel must not offer a per-finger
delete button.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import dbus

import _fprintd_common as common


def main():
    bus = common.system_bus()
    try:
        _device_path, device_obj = common.get_default_device(bus)
    except dbus.DBusException as exc:
        common.fail_and_exit(exc)
        return

    try:
        with common.claimed(device_obj, "") as device_iface:
            device_iface.DeleteEnrolledFingers2()
    except dbus.DBusException as exc:
        common.fail_and_exit(exc)
        return

    common.emit("delete-completed")


if __name__ == "__main__":
    main()
