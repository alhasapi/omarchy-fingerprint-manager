#!/usr/bin/env python3
"""Report the default fprintd device and the current user's enrolled fingers.

Prints one JSON line: {"event":"status","name":...,"scanType":...,
"numEnrollStages":...,"fingers":[...]}, or {"event":"error",...} on failure.

No Claim() needed for ListEnrolledFingers -- confirmed from openfprintd's
source (device.py's ListEnrolledFingers has no ClaimDevice() guard, unlike
EnrollStart/DeleteEnrolledFingers2/etc.), so this can safely interleave with
a concurrent enroll from another instance of this plugin.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import dbus

import _fprintd_common as common


def main():
    bus = common.system_bus()
    try:
        device_path, device_obj = common.get_default_device(bus)
    except dbus.DBusException as exc:
        common.fail_and_exit(exc)
        return

    props_iface = dbus.Interface(device_obj, common.PROPERTIES_INTERFACE)
    device_iface = dbus.Interface(device_obj, common.DEVICE_INTERFACE)

    try:
        props = props_iface.GetAll(common.DEVICE_INTERFACE)
        fingers = device_iface.ListEnrolledFingers("")
    except dbus.DBusException as exc:
        common.fail_and_exit(exc)
        return

    common.emit(
        "status",
        device=str(device_path),
        name=str(props.get("name", "")),
        scanType=str(props.get("scan-type", "")),
        numEnrollStages=int(props.get("num-enroll-stages", -1)),
        fingers=[str(f) for f in fingers],
    )


if __name__ == "__main__":
    main()
